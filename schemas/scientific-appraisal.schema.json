{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:scientific-appraisal:1",
  "title": "Appraisal científico auditável por desfecho",
  "type": "object",
  "additionalProperties": false,
  "required": ["appraisal_id", "job_id", "study_id", "design", "outcome_appraisals", "cross_cutting", "human_judgment_required", "provenance"],
  "properties": {
    "appraisal_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "design": {"type": "string", "minLength": 1},
    "outcome_appraisals": {"type": "array", "minItems": 1},
    "cross_cutting": {"type": "object"},
    "recommendation_boundaries": {"type": "array"},
    "human_judgment_required": {"const": true},
    "provenance": {"type": "object"}
  }
}

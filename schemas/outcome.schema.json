{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:outcome:1",
  "title": "Desfecho",
  "description": "Definição, hierarquia e mensuração de um desfecho sem promover silenciosamente achados exploratórios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome_id",
    "job_id",
    "study_id",
    "name",
    "definition",
    "outcome_type",
    "hierarchy",
    "prespecification",
    "clinical_nature",
    "measurement",
    "timepoints",
    "source_documents",
    "provenance"
  ],
  "properties": {
    "outcome_id": { "$ref": "#/$defs/outcomeId" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "study_id": { "$ref": "#/$defs/studyId" },
    "name": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "domain": { "type": ["string", "null"] },
    "outcome_type": {
      "type": "string",
      "enum": ["eficacia", "seguranca", "qualidade-de-vida", "uso-de-recursos", "diagnostico", "prognostico", "outro"]
    },
    "hierarchy": {
      "type": "string",
      "enum": ["primario", "secundario", "exploratorio", "nao-especificado"],
      "description": "Posição analítica declarada pelo estudo."
    },
    "decision_importance": {
      "type": "string",
      "enum": ["critico-para-decisao", "importante", "complementar", "nao-avaliada"]
    },
    "prespecification": {
      "type": "string",
      "enum": ["pre-especificado", "pos-hoc", "ambiguo", "nao-localizado", "nao-aplicavel"]
    },
    "clinical_nature": {
      "type": "string",
      "enum": ["clinico", "percebido-pelo-paciente", "substituto-validado", "substituto-nao-validado", "biomarcador", "mecanistico", "outro", "incerto"]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "metric", "unit", "scale_min", "scale_max", "better_direction"],
      "properties": {
        "instrument": { "type": ["string", "null"] },
        "metric": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "scale_min": { "type": ["number", "null"] },
        "scale_max": { "type": ["number", "null"] },
        "better_direction": { "type": "string", "enum": ["maior", "menor", "nenhuma", "incerta", "nao-aplicavel"] }
      }
    },
    "timepoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "effect_estimate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^EST-[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "selection_status": {
      "type": "string",
      "enum": ["incluido-na-edicao", "excluido-da-edicao", "pendente"],
      "description": "Decisão editorial separada da hierarquia analítica."
    },
    "selection_reason": { "type": ["string", "null"] },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "studyId": { "type": "string", "pattern": "^STUDY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "outcomeId": { "type": "string", "pattern": "^OUT-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "table", "figure", "section", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "page": { "type": ["integer", "string", "null"], "minimum": 1 },
        "table": { "type": ["string", "null"] },
        "figure": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "extracted_at", "extracted_by", "method"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocator" } },
        "extracted_at": { "type": "string", "format": "date-time" },
        "extracted_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

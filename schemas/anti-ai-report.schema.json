{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:anti-ai-report:1",
  "title": "Relatório contextual de padrões artificiais",
  "description": "Auditoria localizada de padrões de escrita; não mede autoria nem humanidade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "audit_version",
    "artifact_id",
    "artifact_sha256",
    "scope",
    "reference_role",
    "reference_sources",
    "passed",
    "manual_review_required",
    "findings",
    "prohibitions"
  ],
  "properties": {
    "report_id": { "type": "string", "pattern": "^AAI-[A-F0-9]{12}$" },
    "audit_version": { "type": "string", "minLength": 1 },
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "scope": { "type": "string", "minLength": 1 },
    "reference_role": { "type": "string", "minLength": 1 },
    "reference_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/referenceSource" }
    },
    "passed": { "type": "boolean" },
    "manual_review_required": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "referenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "role", "location"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph", "start", "end"],
      "properties": {
        "paragraph": { "type": ["integer", "null"], "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "rule",
        "category",
        "excerpt",
        "location",
        "evidence",
        "severity",
        "confidence",
        "reason",
        "false_positive_risk",
        "localized_recommendation",
        "review_status",
        "requires_manual_confirmation"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^AAI-[0-9]{3,}$" },
        "rule": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "tool-token-leak",
            "chatbot-tone",
            "generic-opening",
            "empty-conclusion",
            "predictable-structure",
            "artificial-parallelism",
            "mechanical-enumeration",
            "excessive-headings",
            "self-importance-announcement",
            "relevance-inflation",
            "semantic-repetition",
            "formulaic-transition",
            "promotional-language",
            "false-precision",
            "vague-attribution",
            "rotating-synonymy",
            "overly-symmetric-sentence",
            "mechanical-not-only-but",
            "metadiscourse",
            "obvious-reexplanation",
            "generic-hedging",
            "uniform-cadence",
            "recap-conclusion"
          ]
        },
        "excerpt": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "evidence": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "major", "moderate", "minor"] },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "minLength": 1 },
        "false_positive_risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "localized_recommendation": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "enum": ["candidate", "confirmed", "rejected"] },
        "requires_manual_confirmation": { "type": "boolean" }
      }
    }
  }
}

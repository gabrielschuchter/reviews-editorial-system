{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:methodological-issue:1",
  "title": "Questão metodológica",
  "description": "Análise específica de ponto forte, limitação, discrepância ou incerteza metodológica.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "job_id",
    "study_id",
    "nature",
    "category",
    "problem",
    "where_identified",
    "methodological_importance",
    "possible_consequence",
    "effect_direction",
    "evidence_strength",
    "conclusion_impact",
    "verification_status",
    "severity",
    "blocks_progress",
    "sources",
    "provenance"
  ],
  "properties": {
    "issue_id": { "$ref": "#/$defs/issueId" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "study_id": { "$ref": "#/$defs/studyId" },
    "nature": {
      "type": "string",
      "enum": ["ponto-forte", "limitacao", "discrepancia", "incerteza", "critica-externa"]
    },
    "category": {
      "type": "string",
      "enum": [
        "risco-de-vies",
        "desenho",
        "multiplicidade",
        "seletividade",
        "perdas",
        "mensuracao",
        "cegamento",
        "alocacao",
        "confusao",
        "ajuste",
        "modelagem",
        "precisao",
        "aplicabilidade",
        "transportabilidade",
        "relevancia-clinica",
        "limites-da-inferencia",
        "causalidade",
        "desfecho-substituto",
        "analise-de-subgrupo",
        "outro"
      ]
    },
    "problem": {
      "type": "string",
      "minLength": 1,
      "description": "Descrição exata do problema ou ponto metodológico, sem crítica genérica."
    },
    "where_identified": { "type": "string", "minLength": 1 },
    "methodological_importance": { "type": "string", "minLength": 1 },
    "possible_consequence": { "type": "string", "minLength": 1 },
    "effect_direction": {
      "type": "string",
      "enum": ["superestima-beneficio", "subestima-beneficio", "superestima-dano", "subestima-dano", "imprevisivel", "nao-inferivel", "nao-aplicavel"]
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["potencial", "provavel", "demonstrada"],
      "description": "Distingue consequência potencial, provável ou demonstrada."
    },
    "conclusion_impact": {
      "type": "string",
      "enum": ["nao-altera", "reduz-seguranca", "altera-interpretacao", "invalida-conclusao", "incerto"]
    },
    "external_criticism_classification": {
      "description": "Classificação obrigatória quando a questão deriva de escrutínio externo.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["crítica documentada", "preocupação plausível", "alegação não confirmada", "problema reconhecido pelos autores", "discrepância verificada"]
        },
        { "type": "null" }
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": ["verificada", "parcialmente-verificada", "nao-verificada", "ambigua", "divergente"]
    },
    "severity": {
      "type": "string",
      "enum": ["critica", "maior", "moderada", "menor", "informativa"]
    },
    "blocks_progress": { "type": "boolean" },
    "related_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceLocator" }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "severity": { "const": "critica" } },
        "required": ["severity"]
      },
      "then": {
        "properties": { "blocks_progress": { "const": true } }
      }
    },
    {
      "if": {
        "properties": { "nature": { "const": "critica-externa" } },
        "required": ["nature"]
      },
      "then": {
        "required": ["external_criticism_classification"],
        "properties": {
          "external_criticism_classification": { "type": "string" }
        }
      }
    }
  ],
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "studyId": { "type": "string", "pattern": "^STUDY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "issueId": { "type": "string", "pattern": "^METH-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "table", "figure", "section", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "page": { "type": ["integer", "string", "null"], "minimum": 1 },
        "table": { "type": ["string", "null"] },
        "figure": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] },
        "url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "accessed_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "method", "search_performed"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "search_performed": { "type": "boolean" },
        "search_date": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

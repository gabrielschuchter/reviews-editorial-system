{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviews.local/schemas/ui-bridge-response.schema.json",
  "title": "Reviews UI bridge response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "command",
    "generated_at",
    "data",
    "warnings",
    "errors",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "data": {},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "meta": {
      "type": "object"
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "recommended_action",
        "category",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "usage_error",
            "editorial_block",
            "environment_failure",
            "internal_failure"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}

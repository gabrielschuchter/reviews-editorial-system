{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviews.local/schemas/memory-item.schema.json",
  "title": "Reviews Historical or Validated Memory Item",
  "type": "object",
  "required": [
    "contract_version",
    "memory_item_id",
    "memory_tier",
    "category",
    "title",
    "content",
    "status",
    "scope",
    "confidence",
    "normative",
    "justification",
    "sources"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "memory_item_id": {"type": "string", "minLength": 1},
    "memory_tier": {"enum": ["historical", "validated"]},
    "category": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "normative": {"type": "boolean"},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "justification": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relationship", "relevance_reason"],
        "properties": {
          "edition_id": {"type": ["string", "null"]},
          "document_id": {"type": ["string", "null"]},
          "version_id": {"type": ["string", "null"]},
          "lesson_id": {"type": ["string", "null"]},
          "relationship": {"type": "string", "minLength": 1},
          "relevance_reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"memory_tier": {"const": "validated"}},
        "required": ["memory_tier"]
      },
      "then": {
        "properties": {
          "normative": {"const": true},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        },
        "required": ["approved_by", "approved_at"]
      }
    }
  ],
  "additionalProperties": false
}

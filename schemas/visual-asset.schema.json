{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:visual-asset:1",
  "title": "Ativo visual",
  "description": "Plano e auditoria de elemento visual opcional, com origem, risco interpretativo e direitos registrados.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "job_id",
    "asset_type",
    "element",
    "function",
    "origin",
    "placement",
    "interpretation_risk",
    "permission_required",
    "rights",
    "decision",
    "generated_scientific_image",
    "generated_editorial_illustration",
    "represents_data",
    "clearly_labeled",
    "data_recreation",
    "source_documents",
    "provenance"
  ],
  "properties": {
    "asset_id": { "type": "string", "pattern": "^VIS-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "asset_type": {
      "type": "string",
      "enum": [
        "article-figure",
        "recreated-chart",
        "reviews-design-component",
        "editorial-illustration",
        "evidence-card",
        "main-findings",
        "study-design",
        "certainty-scale",
        "caveat-box",
        "implications-box",
        "study-flow",
        "pico-summary",
        "other"
      ]
    },
    "element": { "type": "string", "minLength": 1 },
    "function": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "string",
      "enum": ["article", "verified-data-recreation", "reviews-design-system", "editorial-original", "other"]
    },
    "placement": { "type": "string", "minLength": 1 },
    "interpretation_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "description", "mitigation"],
      "properties": {
        "level": { "type": "string", "enum": ["none", "low", "moderate", "high", "unacceptable"] },
        "description": { "type": "string", "minLength": 1 },
        "mitigation": { "type": ["string", "null"] }
      }
    },
    "permission_required": { "type": "boolean" },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "license", "permission_record"],
      "properties": {
        "status": { "type": "string", "enum": ["cleared", "permission-needed", "restricted", "unknown", "not-applicable"] },
        "license": { "type": ["string", "null"] },
        "permission_record": { "type": ["string", "null"] }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["recommend", "do-not-recommend", "pending", "approved", "rejected"]
    },
    "generated_scientific_image": {
      "const": false,
      "description": "Imagens científicas geradas são proibidas."
    },
    "generated_editorial_illustration": { "type": "boolean" },
    "represents_data": { "type": "boolean" },
    "clearly_labeled": { "type": "boolean" },
    "data_recreation": {
      "oneOf": [
        { "$ref": "#/$defs/dataRecreation" },
        { "type": "null" }
      ]
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "source_figure": { "type": ["string", "null"] },
    "caption": { "type": ["string", "null"] },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "origin": { "const": "verified-data-recreation" } },
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "asset_type": { "const": "recreated-chart" },
          "represents_data": { "const": true },
          "clearly_labeled": { "const": true },
          "data_recreation": { "$ref": "#/$defs/dataRecreation" }
        }
      }
    },
    {
      "if": {
        "properties": { "generated_editorial_illustration": { "const": true } },
        "required": ["generated_editorial_illustration"]
      },
      "then": {
        "properties": {
          "asset_type": { "const": "editorial-illustration" },
          "represents_data": { "const": false },
          "clearly_labeled": { "const": true }
        }
      }
    }
  ],
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "dataRecreation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_values", "values_verified", "double_checked", "identified_as_recreation", "source_indicated"],
      "properties": {
        "source_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "unit", "document_id", "page", "table", "figure"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "unit": { "type": ["string", "null"] },
              "document_id": { "$ref": "#/$defs/documentId" },
              "page": { "type": ["integer", "string", "null"], "minimum": 1 },
              "table": { "type": ["string", "null"] },
              "figure": { "type": ["string", "null"] }
            }
          }
        },
        "values_verified": { "const": true },
        "double_checked": { "const": true },
        "identified_as_recreation": { "const": true },
        "source_indicated": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "created_at", "created_by", "method"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "location", "hash"],
            "properties": {
              "document_id": { "$ref": "#/$defs/documentId" },
              "location": { "type": "string", "minLength": 1 },
              "hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

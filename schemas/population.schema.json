{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:population:1",
  "title": "População de estudo",
  "description": "Extração auditável da população, elegibilidade, amostra e características basais.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "population_id",
    "job_id",
    "study_id",
    "label",
    "description",
    "role",
    "eligibility",
    "sample_counts",
    "analysis_population",
    "source_documents",
    "missing_information",
    "provenance"
  ],
  "properties": {
    "population_id": { "$ref": "#/$defs/populationId" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "study_id": { "$ref": "#/$defs/studyId" },
    "label": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Descrição fiel da população, sem completar lacunas por plausibilidade."
    },
    "role": {
      "type": "string",
      "enum": ["alvo", "elegivel", "incluida", "randomizada", "analisada", "subgrupo", "outra"]
    },
    "setting": { "type": ["string", "null"] },
    "locations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inclusion", "exclusion"],
      "properties": {
        "inclusion": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclusion": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sample_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screened", "eligible", "enrolled", "randomized", "analyzed"],
      "properties": {
        "screened": { "type": ["integer", "null"], "minimum": 0 },
        "eligible": { "type": ["integer", "null"], "minimum": 0 },
        "enrolled": { "type": ["integer", "null"], "minimum": 0 },
        "randomized": { "type": ["integer", "null"], "minimum": 0 },
        "analyzed": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "analysis_population": {
      "type": "string",
      "enum": ["intencao-de-tratar", "intencao-de-tratar-modificada", "por-protocolo", "conforme-tratado", "seguranca", "nao-informada", "nao-aplicavel", "outra"]
    },
    "baseline_characteristics": {
      "type": "array",
      "items": { "$ref": "#/$defs/characteristic" }
    },
    "underrepresented_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "possible_effect_modifier", "reason"],
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "possible_effect_modifier": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Informação não localizada nos materiais consultados.",
          "Informação ambígua ou insuficientemente descrita no material disponível."
        ]
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "studyId": { "type": "string", "pattern": "^STUDY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "populationId": { "type": "string", "pattern": "^POP-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "characteristic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "group", "value", "unit", "dispersion", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": ["string", "null"] },
        "value": { "type": ["number", "string", "null"] },
        "unit": { "type": ["string", "null"] },
        "dispersion": { "type": ["string", "null"] },
        "source": { "$ref": "#/$defs/sourceLocator" }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "table", "figure", "section", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "page": { "type": ["integer", "string", "null"], "minimum": 1 },
        "table": { "type": ["string", "null"] },
        "figure": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "extracted_at", "extracted_by", "method"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocator" } },
        "extracted_at": { "type": "string", "format": "date-time" },
        "extracted_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

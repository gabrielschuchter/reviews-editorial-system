{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:study:1",
  "title": "Classificação de estudo",
  "description": "Classificação do desenho e dos limites básicos de inferência de um estudo ou síntese.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "job_id",
    "title",
    "design",
    "design_features",
    "objectives",
    "source_documents",
    "classification_status",
    "provenance"
  ],
  "properties": {
    "study_id": { "$ref": "#/$defs/studyId" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "title": { "type": "string", "minLength": 1 },
    "design": {
      "type": "string",
      "enum": [
        "ensaio-randomizado",
        "ensaio-nao-randomizado",
        "coorte",
        "caso-controle",
        "transversal",
        "estudo-diagnostico",
        "prognostico",
        "revisao-sistematica",
        "metanalise",
        "guideline",
        "revisao-narrativa",
        "protocolo",
        "outro"
      ],
      "description": "Desenho principal conforme a taxonomia do prompt mestre."
    },
    "design_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["paralelo", "crossover", "fatorial", "cluster", "equivalencia", "nao-inferioridade", "superioridade", "pragmatico", "explicativo", "outro"]
      },
      "description": "Características adicionais do delineamento."
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "setting": { "type": ["string", "null"] },
    "study_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "duration": { "type": ["string", "null"] },
    "sample_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "enrolled", "randomized", "analyzed"],
      "properties": {
        "planned": { "type": ["integer", "null"], "minimum": 0 },
        "enrolled": { "type": ["integer", "null"], "minimum": 0 },
        "randomized": { "type": ["integer", "null"], "minimum": 0 },
        "analyzed": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "identifier", "url", "status"],
      "properties": {
        "registry": { "type": ["string", "null"] },
        "identifier": { "type": ["string", "null"] },
        "url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "status": { "type": "string", "enum": ["localizado", "nao-localizado", "nao-aplicavel", "ambiguo"] }
      }
    },
    "population_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entityId" }
    },
    "intervention_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entityId" }
    },
    "outcome_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entityId" }
    },
    "inference_target": { "type": ["string", "null"] },
    "inference_limits": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "classification_status": {
      "type": "string",
      "enum": ["confirmada", "provisoria", "ambigua", "insuficientemente-descrita"]
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" },
      "description": "Documentos que sustentam a classificação."
    },
    "notes": { "type": ["string", "null"] },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "studyId": { "type": "string", "pattern": "^STUDY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "entityId": { "type": "string", "pattern": "^[A-Z]+-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "section", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "page": { "type": ["integer", "string", "null"], "minimum": 1 },
        "section": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "created_at", "created_by", "method"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocator" } },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:audit-issue:1",
  "title": "Achado de auditoria",
  "description": "Achado rastreável de auditoria factual, estatística, metodológica, estrutural, estilística ou final.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_issue_id",
    "job_id",
    "audit_type",
    "finding_type",
    "severity",
    "description",
    "expected",
    "observed",
    "location",
    "status",
    "blocks_progress",
    "source_artifacts",
    "resolution",
    "provenance"
  ],
  "properties": {
    "audit_issue_id": { "type": "string", "pattern": "^AUD-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "audit_type": {
      "type": "string",
      "enum": ["factual", "statistical", "methodological", "structural", "style-reviews", "anti-ai", "coherence", "references", "visual", "final"]
    },
    "finding_type": {
      "type": "string",
      "enum": ["error", "unsupported-claim", "discrepancy", "omission", "ambiguity", "extrapolation", "style-pattern", "warning", "improvement"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "major", "moderate", "minor", "informational"]
    },
    "description": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "observed": { "type": "string", "minLength": 1 },
    "location": { "$ref": "#/$defs/location" },
    "related_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "related_entity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+-[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "status": {
      "type": "string",
      "enum": ["open", "resolved", "accepted-risk", "not-applicable"]
    },
    "blocks_progress": { "type": "boolean" },
    "recommended_action": { "type": ["string", "null"] },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "resolution": {
      "oneOf": [
        { "$ref": "#/$defs/resolution" },
        { "type": "null" }
      ]
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "severity": { "const": "critical" } },
        "required": ["severity"]
      },
      "then": {
        "properties": { "blocks_progress": { "const": true } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "resolved" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "resolution": { "$ref": "#/$defs/resolution" } }
      }
    }
  ],
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "section", "paragraph", "line", "excerpt"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "section": { "type": ["string", "null"] },
        "paragraph": { "type": ["integer", "null"], "minimum": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "location", "hash"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "enum": ["source-document", "claim-ledger", "effect-estimate", "methodological-review", "draft", "audit", "editorial-rule", "other"] },
        "location": { "type": "string", "minLength": 1 },
        "hash": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_taken", "resolved_at", "resolved_by", "verified_by"],
      "properties": {
        "action_taken": { "type": "string", "minLength": 1 },
        "resolved_at": { "type": "string", "format": "date-time" },
        "resolved_by": { "type": "string", "minLength": 1 },
        "verified_by": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_run_id", "created_at", "created_by", "method"],
      "properties": {
        "audit_run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}

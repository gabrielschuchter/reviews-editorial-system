{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reviews-editorial-system:schema:intervention:1",
  "title": "Intervenção ou comparador",
  "description": "Extração estruturada de intervenção, comparador, exposição ou teste avaliado.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intervention_id",
    "job_id",
    "study_id",
    "role",
    "name",
    "description",
    "components",
    "source_documents",
    "provenance"
  ],
  "properties": {
    "intervention_id": { "$ref": "#/$defs/interventionId" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "study_id": { "$ref": "#/$defs/studyId" },
    "role": {
      "type": "string",
      "enum": ["intervencao", "comparador", "exposicao", "nao-exposicao", "teste-indice", "referencia", "outro"]
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["farmacologica", "nao-farmacologica", "procedimento", "diagnostica", "comportamental", "nutricional", "organizacional", "exposicao", "controle", "outra"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dose", "route", "frequency", "duration", "details"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "dose": { "type": ["string", "null"] },
          "route": { "type": ["string", "null"] },
          "frequency": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "details": { "type": ["string", "null"] }
        }
      }
    },
    "arm_label": { "type": ["string", "null"] },
    "cointerventions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "adherence": { "type": ["string", "null"] },
    "fidelity": { "type": ["string", "null"] },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "jobId": { "type": "string", "pattern": "^JOB-[0-9]{4}-[0-9]{3,}$" },
    "studyId": { "type": "string", "pattern": "^STUDY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "interventionId": { "type": "string", "pattern": "^INT-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "documentId": { "type": "string", "pattern": "^DOC-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "page", "table", "figure", "section", "excerpt"],
      "properties": {
        "document_id": { "$ref": "#/$defs/documentId" },
        "page": { "type": ["integer", "string", "null"], "minimum": 1 },
        "table": { "type": ["string", "null"] },
        "figure": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "extracted_at", "extracted_by", "method"],
      "properties": {
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocator" } },
        "extracted_at": { "type": "string", "format": "date-time" },
        "extracted_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
